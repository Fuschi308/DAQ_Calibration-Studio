<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:DAQ.CalibrationStudio.App.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DAQ.CalibrationStudio.App/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://DAQ.CalibrationStudio.App/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector=":is(Window)">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
  </Style>
  <Style Selector="TextBlock.number">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style Selector="TextBlock.reading">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="30" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="44" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.paper">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PaperLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="42,36" />
  </Style>
  <Style Selector="Border.paper TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Border.paper TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
  </Style>
  <Style Selector="Border.line">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="Border.line.strong">
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>
  <Style Selector="Border.strip">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{DynamicResource SubtleStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Border.note">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.note.warn">
    <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
  </Style>
  <Style Selector="Border.note.warn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}" />
  </Style>
  <Style Selector="Border.note.sim">
    <Setter Property="Background" Value="{DynamicResource SimBgBrush}" />
  </Style>
  <Style Selector="Border.note.sim TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SimTextBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource ErrTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.success">
    <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="Button.segment.selected">
    <Setter Property="Background" Value="{DynamicResource SegmentOnBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.device">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="Button.device.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="TextBox.number">
    <Setter Property="TextAlignment" Value="Right" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="ComboBox.compact">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,1" />
  </Style>
  <Style Selector="CheckBox.compact">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource SubtleStrongBrush}" />
  </Style>

  <Style Selector="Border.tableHead">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1" />
    <Setter Property="MinHeight" Value="35" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="Border.tableHead TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tableRow">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="Border.tableRow TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.table">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="-2,0,0,0" />
  </Style>

  <Style Selector="c|StudioIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="c|StudioIcon.titleIcon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="c|StudioIcon.brandIcon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="c|StudioIcon.warn">
    <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}" />
  </Style>
  <Style Selector="c|StudioIcon.sim">
    <Setter Property="Foreground" Value="{DynamicResource OnSimBrush}" />
  </Style>
  <Style Selector="Border.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderBrush" Value="{DynamicResource Text2Brush}" />
    <Setter Property="BorderThickness" Value="1.25" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="c|ToneText.ok">
    <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
  </Style>
  <Style Selector="c|ToneText.warn">
    <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}" />
  </Style>
  <Style Selector="c|ToneText.err">
    <Setter Property="Foreground" Value="{DynamicResource ErrTextBrush}" />
  </Style>
  <Style Selector="c|ToneText.sim">
    <Setter Property="Foreground" Value="{DynamicResource SimTextBrush}" />
  </Style>
  <Style Selector="c|ToneText.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="c|StatusBadge">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Background" Value="{DynamicResource SubtleStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    <Setter Property="Height" Value="20" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="c|StatusBadge.outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="c|StatusBadge.ok">
    <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
  </Style>
  <Style Selector="c|StatusBadge.warn">
    <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}" />
  </Style>
  <Style Selector="c|StatusBadge.err">
    <Setter Property="Background" Value="{DynamicResource ErrBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ErrTextBrush}" />
  </Style>
  <Style Selector="c|StatusBadge.sim">
    <Setter Property="Background" Value="{DynamicResource SimBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SimTextBrush}" />
  </Style>
  <Style Selector="c|StatusBadge.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="c|StateDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
  </Style>
  <Style Selector="c|StateDot.ok">
    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
  </Style>
  <Style Selector="c|StateDot.err">
    <Setter Property="Foreground" Value="{DynamicResource ErrBrush}" />
  </Style>
  <Style Selector="c|StateDot.sim">
    <Setter Property="Foreground" Value="{DynamicResource SimBrush}" />
  </Style>
  <Style Selector="c|StateDot.warn">
    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="c|StateDot.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="c|StateDot">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="c|PaletteMark">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.segments">
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SubtleStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="AutoScrollToSelectedItem" Value="False" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
    </Setter>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.segments ListBoxItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ListBox.segments ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SegmentOnBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.segments ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.tableRow TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="c|ToneText">
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>
  <Style Selector="c|ToneText.metric">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style Selector="c|ToneText.number">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ScrollViewer.overviewAside">
    <Setter Property="Width" Value="400" />
  </Style>
  <Style Selector="ListBox.overviewTable">
    <Setter Property="MaxHeight" Value="558" />
  </Style>
  <Style Selector="ScrollViewer.profilesAside">
    <Setter Property="Width" Value="380" />
  </Style>
  <Style Selector="ScrollViewer.profilesList">
    <Setter Property="Width" Value="300" />
  </Style>
  <Style Selector="Border.historyList">
    <Setter Property="Width" Value="700" />
  </Style>
  <Style Selector="ListBox.cards">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Border.paper c|ToneText">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Border.paper Border.tableHead">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Border.paper Border.tableHead TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
  </Style>
  <Style Selector="Border.paper c|StatusBadge.ok">
    <Setter Property="Background" Value="{DynamicResource PaperOkBgBrush}" />
  </Style>
  <Style Selector="Border.paper c|StatusBadge.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PaperOkBrush}" />
  </Style>
  <Style Selector="Border.paper c|StatusBadge.warn">
    <Setter Property="Background" Value="{DynamicResource PaperWarnBgBrush}" />
  </Style>
  <Style Selector="Border.paper c|StatusBadge.warn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PaperWarnBrush}" />
  </Style>
  <Style Selector="Border.paper c|StatusBadge.err">
    <Setter Property="Background" Value="{DynamicResource PaperErrBgBrush}" />
  </Style>
  <Style Selector="Border.paper c|StatusBadge.err TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PaperErrBrush}" />
  </Style>
  <Style Selector="Border.paper Border.tableRow">
    <Setter Property="BorderBrush" Value="{DynamicResource PaperLineBrush}" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="StackPanel.fnirsiAside">
    <Setter Property="Width" Value="560" />
  </Style>
  <Style Selector="c|StudioChart.scopePlot">
    <Setter Property="Height" Value="458" />
  </Style>
  <Style Selector="ListBox.sectionNav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.sectionNav ListBoxItem">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,3" />
  </Style>
  <Style Selector="ListBox.sectionNav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</Styles>
